# ==========================================================================
# .env 样例 —— 复制为 .env 后按本机情况填写：
#     cp .env.example .env          (PowerShell: Copy-Item .env.example .env)
# .env 已被 .gitignore 过滤，永远不会进入版本库；本样例文件随仓库分发。
#
# 命名规则：全部以 SG_ 开头。
#   SG_DB_DEFAULT_HOST → db.default.host（按下划线展开为嵌套路径）
#   扁平写法（全库唯一时可省略节名）：SG_LOG_LEVEL → log.level
# 优先级：真实环境变量 > .env > conf/config.local.yaml >
#         conf/config.<profile>.yaml > conf/config.yaml > 代码默认值
# ==========================================================================

# ---- 环境标签与 Profile 选择 ----
# app.env 只是用于日志/可观测性的标签；SG_PROFILE 决定加载哪些 yaml 覆盖层。
# 两者通常取相同值，但框架不强制（详见 docs/config.md）。
SG_APP_ENV=dev
# SG_PROFILE=dev                    # 例：prod / staging,canary / region-cn-north

SG_APP_DEBUG=true
SG_LOG_LEVEL=DEBUG

# ---- 主密钥（必填）----
# 本地开发：生成一次填进来，丢失后所有已签发 token 失效。
#   python -c "import secrets; print(secrets.token_hex(32))"
# 生产/K8s：改用 KMS 或 K8s Secret 注入，不要把真实值写进任何入库文件。
SG_MASTER_KEY=REPLACE_WITH_64_HEX_CHARS

# ---- 运行时守卫（一般保持开启）----
SG_CHECK_DO_LEAK=1

# ---- 数据库（不填则沿用 conf/config.yaml）----
# SG_DB_DEFAULT_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:15432/sagitta
# SG_DB_DEFAULT_HOST=127.0.0.1
# SG_DB_DEFAULT_PORT=15432
# SG_DB_DEFAULT_PASSWORD=postgres

# ---- Redis ----
# SG_REDIS_DEFAULT_URL=redis://127.0.0.1:16379/0
# SG_REDIS_AUTH_URL=redis://127.0.0.1:16379/1

# ---- 文件存储（凭据请与 docker-compose.dev.yml 的 MinIO 保持一致）----
# SG_FILE_ENDPOINT=http://127.0.0.1:9000
# SG_FILE_ACCESS_KEY=admin
# SG_FILE_SECRET_KEY=admin123456
# SG_FILE_BUCKET=demo

# ---- 构建版本（CI 注入；本地无需填写）----
# SG_BUILD_COMMIT=
