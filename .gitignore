# ---- Python 字节码与缓存 ----
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ---- 构建/打包产物 ----
build/
dist/

# ---- 虚拟环境 ----
.venv/
venv/

# ---- IDE ----
.idea/

# ---- 环境密钥（真实值绝不入库；样例 *.example 随仓库分发，供复制使用）----
.env
.env.*
!.env.example
!.env.*.example

# ---- 个人配置覆盖层（仅本机生效；profile 文件 config.<name>.yaml 入库）----
conf/config.local.yaml

# ---- 运行日志（保留 logs/ 目录本身）----
logs/*.log
